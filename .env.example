# ==============================================================================
# ResolveX — Environment Configuration Template
# Autonomous Customer Incident Intelligence
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env in local development: cp .env.example .env
# 2. Fill in values for your Supabase project and Google Gemini API key.
# 3. NEVER commit real credentials or .env files to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND CONFIGURATION (apps/web)
# Public variables exposed to the Next.js client-side browser bundle.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="ResolveX"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"

# Supabase Public Keys (Protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_URL="https://your-supabase-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key"

# Demo Mode Toggle (Forces deterministic fallback mocks if LLM rate limits hit)
NEXT_PUBLIC_DEMO_MODE=true

# ------------------------------------------------------------------------------
# 2. BACKEND & DATABASE CONFIGURATION (apps/api)
# Server-side ONLY. Must NEVER be exposed to the browser or client bundle.
# ------------------------------------------------------------------------------
API_PORT=8000
API_HOST="0.0.0.0"
ENVIRONMENT="development"
LOG_LEVEL="INFO"

# Supabase Server-side Connection
SUPABASE_URL="https://your-supabase-project-id.supabase.co"

# WARNING: CRITICAL SECURITY BOUNDARY
# The Service Role Key bypasses all Row Level Security.
# It MUST NEVER be prefixed with NEXT_PUBLIC_ or used on the frontend.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key"

# Supabase JWT Secret (Used by FastAPI backend to verify incoming client auth tokens)
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"

# ------------------------------------------------------------------------------
# 3. AI & ORCHESTRATION (Google Gemini & ChromaDB)
# ------------------------------------------------------------------------------
# Google Gemini API Key (Gemini 2.0 Flash & Gemini 1.5 Pro)
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# ChromaDB Vector Store URL (Local or hosted vector database for policy RAG)
CHROMA_URL="http://localhost:8000/chroma"
CHROMA_PERSIST_DIRECTORY="./data/chromadb"

# ------------------------------------------------------------------------------
# 4. SYSTEM & DEMO SIMULATION SETTINGS
# ------------------------------------------------------------------------------
# Fixed random seed for deterministic synthetic Acme Commerce fixtures
DEMO_RANDOM_SEED=42
DEFAULT_TENANT_SLUG="acme-commerce"
